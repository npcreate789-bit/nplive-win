<?xml version="1.0" encoding="utf-8"?>
<!--
  NP Create — macOS installer UI definition (v1.8.14, v2).

  Read by productbuild + Installer.app. Controls the customer-facing
  installer experience: welcome screen, license, background image,
  and the single embedded component that runs.

  Single component install:
    com.npcreate.studio  →  /Applications/NP Create/

  Layout once installed:
    NP-Create.app/    PyInstaller bundle (Python embedded)
    .tools/macos/     adb, JDK 21, lspatch, ffmpeg, scrcpy, mediamtx
    apk/              vcam-app-release.apk (LSPatch module)
    MANUAL_TH.md      customer manual

  No external Python install — the .app is self-contained.

  String placeholders {NPC_*} are replaced by build_macos_pkg.sh
  before productbuild reads the file.
-->
<installer-gui-script minSpecVersion="2">
    <title>{NPC_TITLE}</title>
    <organization>com.npcreate.studio</organization>
    <domains enable_localSystem="true"/>

    <!-- Visual customisation: dark-red branded background. The same
         PNG renders in both light + dark Aqua modes.

         v1.8.14 stability fix: switched ``scaling="proportional"``
         → ``scaling="tofit"``. ``proportional`` caused some customer
         machines (notably 1366×768 laptops with Display Scaling on)
         to compute a non-standard window height where the
         Installer.app's bottom navigation chrome (Go Back / Continue
         buttons) ended up clipped below the visible area. ``tofit``
         is what Apple's own .pkg installers use — it keeps the
         left-pane image scaled within its 620×418 frame without
         ever influencing the overall window height. -->
    <background file="background.png"
                alignment="bottomleft"
                scaling="tofit"
                mime-type="image/png"/>
    <background-darkAqua file="background.png"
                          alignment="bottomleft"
                          scaling="tofit"
                          mime-type="image/png"/>
    <!-- v1.8.14 stability fix: welcome + conclusion moved
         HTML → RTF. macOS Installer.app's WebKit-backed HTML
         renderer has long-standing quirks where content height
         calculations can push the window chrome off-screen on
         non-default DPI / accessibility configurations, hiding
         the Go Back / Continue buttons. RTF uses native AppKit
         text rendering (the same path Apple's own installers
         take) so the layout is deterministic across every macOS
         version we support. -->
    <welcome file="welcome.rtf" mime-type="application/rtf"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.rtf" mime-type="application/rtf"/>

    <!-- Minimum macOS = Big Sur (11.0). Covers Apple Silicon and
         every Intel Mac still receiving Apple security updates. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <!-- No checkbox UI; the single component is required.
         ``rootVolumeOnly="true"`` removes the volume picker so the
         installer never adds the extra "Destination Select" pane —
         one fewer screen means one fewer place the bottom button
         row can be pushed off the customer's display. -->
    <options customize="never" allow-external-scripts="no" rootVolumeOnly="true" require-scripts="false"/>

    <choices-outline>
        <line choice="default">
            <line choice="npcreate"/>
        </line>
    </choices-outline>

    <choice id="default" title="{NPC_TITLE}"/>

    <choice id="npcreate"
            visible="false"
            title="NP Create"
            description="โปรแกรม NP Create และเครื่องมือที่เกี่ยวข้อง">
        <pkg-ref id="com.npcreate.studio"/>
    </choice>

    <!-- NP Create app component. Built by pkgbuild against the
         staged tree; {NPC_APP_PKG} is the local filename
         build_macos_pkg.sh produces. -->
    <pkg-ref id="com.npcreate.studio"
             version="{NPC_VERSION}"
             onConclusion="none"
             auth="Root">{NPC_APP_PKG}</pkg-ref>
</installer-gui-script>
